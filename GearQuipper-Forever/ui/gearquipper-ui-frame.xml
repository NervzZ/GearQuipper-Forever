<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- The GearQuipper panel. Its tabs, inset, lists and footers are built in ui/gearquipper-ui-frame.lua (c:InitUiFrame)
	     and ui/gearquipper-ui-frame-events.lua; every widget goes through the skin adapter (c:Skin). -->
	<Frame name="GqUiFrame" inherits="DefaultPanelTemplate" parent="PaperDollFrame" frameStrata="LOW" hidden="true">
		<!-- the height follows the character window (c:InitUiFrame / OnShow) -->
		<Size x="320" y="484"/>
		<!-- beside the character window, right of its side tabs; recomputed by c:SetGqUiFramePosition() -->
		<Anchors>
			<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" x="66" y="0"/>
		</Anchors>
		<Frames>
			<Button parentKey="CloseButton" inherits="UIPanelCloseButtonDefaultAnchors"/>
		</Frames>
		<Scripts>
			<OnShow>
				GqUiFrame_OnShow(self);
				PlaySound(839);
			</OnShow>
			<OnHide>
				GqUiFrame_OnHide(self);
				PlaySound(840);
			</OnHide>
		</Scripts>
	</Frame>
</Ui>
